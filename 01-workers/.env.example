# Cloudflare 配置
# 复制此文件为 .env 并填入实际值
# 不要将 .env 提交到版本控制系统

# Cloudflare 账户 ID
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# D1 数据库配置
D1_DATABASE_ID=your_d1_database_id_here

# 应用配置
EMAIL_DOMAIN=your_domain.com
COOKIES_SECRET=your_cookies_secret_here

# Turnstile 配置
TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# KV 命名空间配置
SESSIONS_KV_ID=your_sessions_kv_id_here
SESSIONS_KV_PREVIEW_ID=your_sessions_kv_preview_id_here

BLACKLIST_KV_ID=your_blacklist_kv_id_here
BLACKLIST_KV_PREVIEW_ID=your_blacklist_kv_preview_id_here

RATE_LIMIT_KV_ID=your_rate_limit_kv_id_here
RATE_LIMIT_KV_PREVIEW_ID=your_rate_limit_kv_preview_id_here

TOKEN_BUCKET_KV_ID=your_token_bucket_kv_id_here
TOKEN_BUCKET_KV_PREVIEW_ID=your_token_bucket_kv_preview_id_here

CACHE_KV_ID=your_cache_kv_id_here
CACHE_KV_PREVIEW_ID=your_cache_kv_preview_id_here
